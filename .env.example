# =====================================================================
# Provider selection
# =====================================================================
# LLM_PROVIDER:    ollama (default, local, GPU) | groq (cloud, free tier)
# EMBED_PROVIDER:  ollama (default)             | hf_endpoint (HF Inference)
# Local dev: leave both as "ollama".
# Streamlit Cloud / online deploy: set LLM_PROVIDER=groq and
# EMBED_PROVIDER=hf_endpoint, plus the GROQ_API_KEY / HF_TOKEN below.
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama

# =====================================================================
# Ollama (local)
# =====================================================================
OLLAMA_HOST=http://localhost:11434
# Models (must be pulled with `ollama pull <name>` first)
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# =====================================================================
# Groq (cloud LLM, free tier) -- get a key at https://console.groq.com
# =====================================================================
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.1-8b-instant

# =====================================================================
# HuggingFace Inference (cloud embeddings, free tier)
# Get a token at https://huggingface.co/settings/tokens (read-only is fine)
# This is the SAME nomic-embed-text-v1.5 weights Ollama bundles, so an index
# built locally is reusable in cloud deploys with no re-indexing.
# =====================================================================
HF_TOKEN=
HF_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# =====================================================================
# Ingestion tunables
# =====================================================================
CHUNK_SIZE=700
CHUNK_OVERLAP=80

# =====================================================================
# Retrieval
# =====================================================================
RETRIEVAL_K=8
RETRIEVAL_FETCH_K=20
# similarity | mmr (Maximal Marginal Relevance for diversity)
RETRIEVAL_SEARCH_TYPE=mmr
# Hybrid retrieval (BM25 lexical + FAISS dense, ensembled)
RETRIEVAL_HYBRID=true
# 0.0 = pure FAISS, 1.0 = pure BM25, 0.5 = equal weight
RETRIEVAL_BM25_WEIGHT=0.5
