# =====================================================================
# LLM provider
# =====================================================================
# ollama (default, local, GPU) | groq (cloud, free tier)
LLM_PROVIDER=ollama

# Ollama (local) -- pull the model first: ollama pull llama3.1:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b

# Groq (cloud) -- free key at https://console.groq.com
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
# How long the model reasons before answering (low | medium | high).
GROQ_REASONING_EFFORT=low

# =====================================================================
# Embeddings (in-process via fastembed; no key needed)
# =====================================================================
EMBED_MODEL=BAAI/bge-small-en-v1.5

# =====================================================================
# News
# =====================================================================
# SEC EDGAR 8-K filings need a contact in the User-Agent, in the form
# "Your Name you@example.com". Leave empty to skip that feed.
SEC_USER_AGENT=
# Hours of news the briefing covers, the chat searches, and the store keeps.
BRIEFING_WINDOW_HOURS=24
SEARCH_WINDOW_HOURS=48
RETENTION_HOURS=72
# Re-read the feeds when the last fetch is older than this.
REFRESH_MINUTES=20

# =====================================================================
# Retrieval
# =====================================================================
RETRIEVAL_K=8
RRF_K=60
# Search recency boost (0 = off; see src/retriever.py for why it's off).
RECENCY_WEIGHT=0
RECENCY_HALF_LIFE_HOURS=12
BRIEFING_RECENCY_WEIGHT=0.4
# Headline similarity above which two articles count as the same story.
DUPLICATE_THRESHOLD=0.8
