# Copy this file to `.streamlit/secrets.toml` for local Streamlit testing,
# OR paste these key/value pairs into the "Secrets" panel of your
# Streamlit Community Cloud deployment (App settings -> Secrets).
#
# Streamlit auto-injects everything in [secrets] as environment variables
# at runtime, so the same code that reads os.getenv("GROQ_API_KEY") locally
# works in the cloud with zero changes.

# --- Provider selection ----------------------------------------------------
# Force the cloud providers; locally these default to "ollama".
LLM_PROVIDER   = "groq"
EMBED_PROVIDER = "hf_endpoint"

# --- Groq (LLM) ------------------------------------------------------------
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY   = "gsk_..."
GROQ_LLM_MODEL = "llama-3.1-8b-instant"

# --- HuggingFace Inference (embeddings) ------------------------------------
# Get a free read-only token: https://huggingface.co/settings/tokens
HF_TOKEN        = "hf_..."
HF_EMBED_MODEL  = "nomic-ai/nomic-embed-text-v1.5"
