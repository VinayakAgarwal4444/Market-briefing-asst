# Copy this file to `.streamlit/secrets.toml` for local Streamlit testing,
# OR paste these key/value pairs into the "Secrets" panel of your
# Streamlit Community Cloud deployment (App settings -> Secrets).
#
# app.py copies every secret into the environment before anything else is
# imported, so the same os.getenv-based config works locally and in the cloud.

# --- LLM (Groq) -------------------------------------------------------------
# Get a free key: https://console.groq.com/keys
LLM_PROVIDER   = "groq"
GROQ_API_KEY   = "gsk_..."
GROQ_LLM_MODEL = "openai/gpt-oss-20b"

# --- Optional: SEC EDGAR 8-K filings ----------------------------------------
# SEC_USER_AGENT = "Your Name you@example.com"
